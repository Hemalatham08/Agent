# Direct FastAPI backend URL.
# For local development you can alternatively set this to /api and use the
# Vite proxy configured in vite.config.ts.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Bearer token used by the "Switch AI model" control.
# It must match AI_SWITCH_TOKEN on the backend. When left empty the model
# switcher stays visible but the backend rejects switches with HTTP 403.
VITE_AI_SWITCH_TOKEN=
